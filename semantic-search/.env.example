# Copy to `.env` and fill in your values:  cp .env.example .env

# --- What to search ---
QUERY=how do I get my money back?
# Path to a text file, one document per line:
CORPUS=./docs.txt

# --- How many matches to return ---
TOP_K=3

# --- Delivery: stdout | telegram | webhook | websocket ---
ALERT_SINK=stdout

# telegram sink (create a bot via @BotFather, get your id via @userinfobot):
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
# TELEGRAM_CHAT_ID=123456789

# webhook sink — POSTs the JSON matches payload to this URL:
# WEBHOOK_URL=https://your-service.example.com/search

# websocket sink — pushes the JSON matches payload to this WS URL (needs `websocat`):
# WS_URL=ws://localhost:8080

# --- pay.sh embeddings endpoint (optional; override if your route differs) ---
# PAYSH_EMBED_URL=https://vertex.pay.sh/embeddings
