# Copy to `.env` and fill in your values:  cp .env.example .env

# --- What to watch ---
COLLECTION=sol_otters

# --- Your lines (set at least one) ---
# Alert when the floor drops to or below this (a buy signal):
FLOOR_BELOW_SOL=13
# Alert when the floor rises to or above this (a sell / take-profit signal):
# FLOOR_ABOVE_SOL=25

# --- Delivery: stdout | telegram | webhook | websocket ---
ALERT_SINK=stdout

# telegram sink (create a bot via @BotFather, get your id via @userinfobot):
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
# TELEGRAM_CHAT_ID=123456789

# webhook sink — POSTs the JSON alert payload to this URL:
# WEBHOOK_URL=https://your-service.example.com/nft-floor

# websocket sink — pushes the JSON alert payload to this WS URL (needs `websocat`):
# WS_URL=ws://localhost:8080

# --- pay.sh endpoint (optional; override if your route differs) ---
# PAYSH_NFT_URL=https://market.pay.sh/nft/floor
