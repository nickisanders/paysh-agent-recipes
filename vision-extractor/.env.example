# Copy to `.env` and fill in your values:  cp .env.example .env

# --- What to read ---
IMAGE=./receipt.jpg

# --- Fields to pull (comma-separated; leave empty to return everything) ---
FIELDS=merchant,date,total,currency,items

# --- Delivery: stdout | telegram | webhook | websocket ---
ALERT_SINK=stdout

# telegram sink (create a bot via @BotFather, get your id via @userinfobot):
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
# TELEGRAM_CHAT_ID=123456789

# webhook sink — POSTs the JSON extraction payload to this URL:
# WEBHOOK_URL=https://your-service.example.com/vision

# websocket sink — pushes the JSON extraction payload to this WS URL (needs `websocat`):
# WS_URL=ws://localhost:8080

# --- pay.sh vision endpoint (optional; override if your route differs) ---
# PAYSH_VISION_URL=https://gemini.pay.sh/vision
