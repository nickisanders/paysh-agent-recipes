# Copy to `.env` and fill in your values:  cp .env.example .env

# --- Where Spend Guard writes its ledgers ---
# Matches the Spend Guard recipe's default. Point this at your real state dir.
GUARD_STATE_DIR=~/.spend-guard

# --- Delivery: stdout | telegram | webhook | websocket ---
ALERT_SINK=stdout

# telegram sink (create a bot via @BotFather, get your id via @userinfobot):
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_bot_token
# TELEGRAM_CHAT_ID=123456789

# webhook sink — POSTs the JSON report payload to this URL:
# WEBHOOK_URL=https://your-service.example.com/spend-report

# websocket sink — pushes the JSON report payload to this WS URL (needs `websocat`):
# WS_URL=ws://localhost:8080
